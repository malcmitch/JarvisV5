{
  "name": "jarvis-client",
  "version": "1.1.0",
  "description": "Jarvis V5 - AI Desktop Assistant",
  "main": "dist-electron/main.js",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n \"NEXT,HTTPS,ELECTRON\" -c \"cyan,magenta,green\" \"next dev\" \"wait-on http://localhost:3000 && node electron-scripts/https-proxy.js\" \"wait-on http://localhost:3000 && electron .\"",
    "serve": "next build && next start -H 0.0.0.0 -p 3000",
    "build:next": "next build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:python": "node electron-scripts/build-python.js",
    "build": "npm run build:python && npm run build:next && node electron-scripts/postbuild.js && npm run build:electron",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "dist": "npm run build && electron-builder --mac --win --publish never",
    "start": "electron .",
    "lint": "eslint"
  },
  "dependencies": {
    "@elevenlabs/react": "^1.4.0",
    "@picovoice/porcupine-node": "^4.0.2",
    "@picovoice/pvrecorder-node": "^1.2.8",
    "@types/leaflet": "^1.9.21",
    "leaflet": "^1.9.4",
    "mqtt": "^5.15.1",
    "node-hid": "^3.4.0",
    "smart-buffer": "^4.2.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@jitsi/robotjs": "^0.6.22",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@tailwindcss/postcss": "^4",
    "@types/http-proxy": "^1.17.17",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "clsx": "^2.1.1",
    "concurrently": "^9.0.0",
    "electron": "^36.0.0",
    "electron-builder": "^26.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "framer-motion": "^12.33.0",
    "http-proxy": "^1.18.1",
    "next": "16.1.6",
    "openai": "^6.18.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "screenshot-desktop": "^1.15.4",
    "selfsigned": "^5.5.0",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4",
    "three": "^0.182.0",
    "three-stdlib": "^2.36.1",
    "typescript": "^5",
    "wait-on": "^8.0.0"
  }
}
