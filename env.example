# Jarvis needs no API keys.
#
# Voice and AI usage are bought by the account you sign in with at
# jarvisdesktop.com, which holds the ElevenLabs and OpenAI credentials
# server-side. Nothing in this file is required to run the app.

# Point a development build at a local jarvis-web instead of production.
# Must be the host that serves the API directly. If it redirects (the apex
# jarvisdesktop.com 308s to www), the bearer token is stripped in transit and
# every request comes back 401.
# JARVIS_WEB_ORIGIN=http://localhost:3000
