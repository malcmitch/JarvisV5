# Dependencies
node_modules/

# Next.js
.next/
out/

# Electron build output
dist-electron/
release/

# Environment
.env
.env.local
.env.*.local
.bambu-token.json

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Local Python venv
.venv*/

# TypeScript incremental
*.tsbuildinfo

# Config files (may contain API keys)
jarvis-mcp.config.json
jarvis-skills.config.json
jarvis-server-settings.json

# Social dashboard HTML captures (may contain session/PII)
social-captures/

# Build artifacts
.playwright-mcp/
.pyinstaller/
scripts/__pycache__/
.eb-cache/

# Compiled PyInstaller helpers, ~78 MB and only runnable on the OS and
# architecture that built them. The release workflow compiles them per platform,
# and the app falls back to running the .py with the user's Python when absent.
scripts/dist/

# MediaPipe wasm runtime — 33MB, generated by `npm run sync:mediapipe`
public/mediapipe/wasm/

# Uncompressed 3D masters, kept by `npm run optimize:assets` so models can be
# re-exported at different settings. Not needed to build or run the app —
# archive it elsewhere if you want the disk space back.
art-source/

# Agent config snapshots taken before an `npm run el:sync` / `el:tune`. Can
# contain tool auth headers, so they stay local.
elevenlabs-tools/_backups/

# Per-account memory written by app/api/memory
jarvis-memory.json

# Where the Electron main process publishes its loopback AI bridge. Holds a
# per-launch secret, and is rewritten on every start.
ai-proxy.json
